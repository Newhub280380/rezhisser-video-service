# Rezhisser — production environment template.
# Copy to .env and run `npm start`. The process reads this file and does not
# override variables that are already set. Never commit real secrets.
# If a key below is empty, the API names it and does not return a fake result.

# --- Core -----------------------------------------------------------------
NODE_ENV=production
# Railway sets PORT automatically.
PORT=3000
# Public origin of the service, no trailing slash. Required for password-reset
# emails and secure cookies, e.g. https://rezhisser.up.railway.app
PUBLIC_ORIGIN=
# Other sites allowed to call the public demo API (comma separated).
ALLOWED_ORIGINS=https://business-41.pazi.dev
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
IMAGE_MAX_BYTES=262144

# --- PostgreSQL -----------------------------------------------------------
# On Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# disable | require | no-verify (empty = driver default; Railway internal network needs none)
DATABASE_SSL=
# Apply schema + library on startup. On Railway the pre-deploy step already
# runs `npm run db:migrate`, so this can be false there (it is idempotent).
DB_AUTO_MIGRATE=false

# --- Accounts (JWT) -------------------------------------------------------
# >= 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=604800

# --- Video generation: ByteDance (Bitdance) Seedance 2.5 via ModelArk ------
SEEDANCE_API_KEY=
# Model / endpoint id from the ModelArk console (e.g. the Seedance 2.5 model id or ep-xxxx endpoint).
SEEDANCE_MODEL=
# BytePlus (international): https://ark.ap-southeast.bytepluses.com/api/v3
# Volcengine (China):       https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_RESOLUTION=720p
SEEDANCE_GENERATE_AUDIO=true
# How the uploaded photo is used: first_frame | reference_image
SEEDANCE_IMAGE_ROLE=first_frame
# Optional fixed request fields (JSON object, cannot override model/content), e.g. {"watermark":false}
SEEDANCE_EXTRA_INPUT_JSON=
SEEDANCE_POLL_INTERVAL_MS=5000
SEEDANCE_MAX_WAIT_MS=900000
SEEDANCE_REQUEST_TIMEOUT_MS=30000
SEEDANCE_MAX_CONCURRENT=4

# --- Video storage: Backblaze B2 / AWS S3 / MinIO (S3 API) -----------------
# Backblaze B2 example: https://s3.us-west-004.backblazeb2.com with region us-west-004
S3_ENDPOINT=
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Videos are deleted by the cleanup cron after this many days.
VIDEO_RETENTION_DAYS=30
# Lifetime of signed playback/download links.
VIDEO_URL_TTL_SECONDS=3600

# --- Payments: YooKassa (primary, RU/KZ) ----------------------------------
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_CURRENCIES=RUB,KZT
# Webhook URL to register in YooKassa: ${PUBLIC_ORIGIN}/api/payment/webhook/yookassa
# Events: payment.succeeded, payment.canceled, refund.succeeded

# --- Payments: Stripe (fallback, global cards) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,CNY,KZT,RUB
# Webhook URL: ${PUBLIC_ORIGIN}/api/payment/webhook/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired, charge.refunded

# --- Plans ----------------------------------------------------------------
PRO_VIDEOS_PER_PERIOD=50
# Empty = unlimited Studio tier.
STUDIO_VIDEOS_PER_PERIOD=
# Optional price overrides in minor units, e.g. {"pro":{"RUB":49900},"studio":{"KZT":990000}}
PRICES_JSON=

# --- Email (password reset) via Resend ------------------------------------
RESEND_API_KEY=
MAIL_FROM=Rezhisser <no-reply@example.com>

# --- Replicate private beta (optional) ------------------------------------
# VIDEO_PROVIDER=local-simulation means Replicate is off: video requests are
# refused until this is `replicate` and REPLICATE_API_TOKEN is set.
DATA_DIR=./data
VIDEO_PROVIDER=local-simulation
DIRECTOR_ADVISOR=none
PAID_GENERATION_ENABLED=false
BETA_ACCESS_KEY=
PAID_DAILY_BUDGET_USD=0
PAID_DAILY_JOB_LIMIT=3
PAID_TOTAL_JOB_LIMIT=20
REPLICATE_API_TOKEN=
VIDEO_MODEL_PROFILES_JSON=

# --- Browser automation: Owl Browser (optional) ---------------------------
# Without URL + token, automation runs are refused (not simulated).
OWL_BROWSER_URL=
OWL_BROWSER_TOKEN=
OWL_BROWSER_API_PREFIX=/api
OWL_BROWSER_ALLOW_HTTP=false
# Region -> proxy URL, e.g. {"EU":"socks5://eu-proxy.example:1080"}
OWL_BROWSER_PROXIES_JSON=
OWL_BROWSER_MAX_CONCURRENT=2

# --- Recipe runner ---------------------------------------------------------
# Dry-run is the default: the director returns a full plan and does not call
# paid tools. Set to false only together with a per-job budget below.
RECIPE_DRY_RUN=true
# Explicit cap for one recipe job. Empty is not a cap; live calls stay off.
# A request may pass a lower budgetUsd / budgetCredits, never a higher one.
RECIPE_JOB_BUDGET_USD=
RECIPE_JOB_BUDGET_CREDITS=
# Local safety hold counted against the cap before a paid step. Not a vendor price.
RECIPE_STEP_HOLD_USD=1

# --- Film pipeline (/film, /api/film/*) -----------------------------------
# Template reels and long films (24-36 scenes): plan -> render every scene in
# parallel -> upscale -> assemble one MP4. Off by default; while it is off the
# /api/film routes do not exist. Each stage also needs its own variables below.
FILM_ENABLED=false

# Screenplay for long films: an SGLang server (OpenAI-compatible API). The shot
# plan is requested with a JSON schema and validated again by the service.
# Template reels do not need it.
SGLANG_BASE_URL=
SGLANG_MODEL=
SGLANG_API_KEY=
SGLANG_REQUEST_TIMEOUT_MS=180000

# Rendering, first match wins:
#   1. RAY_DASHBOARD_URL  - an existing Ray cluster (Jobs REST API);
#   2. SKYPILOT_ENABLED   - rent a GPU cluster per film and destroy it after;
#   3. otherwise          - this machine, scenes in parallel through Seedance
#                           (SEEDANCE_API_KEY / SEEDANCE_MODEL above).
# Modes 1 and 2 run python/rezhisser_film/film_job.py on the cluster. It sends
# every scene to a render service you operate:
#   POST {FILM_RENDER_ENDPOINT}/render -> {"url": "https://..."}
# This repository does not include that service or a video model for it.
FILM_RENDER_ENDPOINT=
RAY_DASHBOARD_URL=
RAY_DASHBOARD_TOKEN=
# The driver must be on the cluster: either already there (RAY_ENTRYPOINT can
# point at it) or fetched from a remote URI given here (zip / git / s3).
RAY_WORKING_DIR=
RAY_ENTRYPOINT=python film_job.py
RAY_POLL_INTERVAL_MS=3000

# SkyPilot (needs the `sky` CLI and cloud credentials on this machine).
# Dry-run is the default and never starts a cluster. A real run also requires
# a price ceiling: without SKYPILOT_MAX_HOURLY_USD nothing is rented.
SKYPILOT_ENABLED=false
SKYPILOT_DRY_RUN=true
SKYPILOT_BIN=sky
# Task file; default: python/rezhisser_film/sky_task.yaml of this repository.
SKYPILOT_TASK_YAML=
# Spot capacity is cheaper but can be interrupted; set false for on-demand.
# Whether spot is offered depends on the cloud.
SKYPILOT_USE_SPOT=true
# Clouds to consider, comma-separated (for example: runpod,vast). Empty = any
# cloud enabled in SkyPilot.
SKYPILOT_CLOUDS=
SKYPILOT_MAX_HOURLY_USD=
FILM_ACCELERATORS=L4:1,A10G:1,L40S:1,A100:1,RTX4090:1
FILM_MAX_RUNTIME_SECONDS=5400

# Local rendering: scenes rendered at once, and the clip lengths the video
# provider accepts (plan durations are aligned to them).
FILM_LOCAL_CONCURRENCY=4
FILM_SCENE_DURATIONS=5,10

# Scenes are rendered at the cheap base resolution and scaled to the target.
FILM_BASE_RESOLUTION=480p
FILM_TARGET_RESOLUTION=2160p
# Upscaler: a command run once per clip, with {in} and {out} file placeholders.
# ReCaVSR and its weights are not part of this repository. Example only:
#   RECAVSR_COMMAND=python /opt/recavsr/infer.py --input {in} --output {out}
# Empty = clips are resized with ffmpeg (Lanczos), and the job is labelled so.
RECAVSR_COMMAND=
RECAVSR_TIMEOUT_MS=1800000
# true = fail the film when a clip cannot be upscaled; false = keep the clip.
FILM_UPSCALE_REQUIRED=false

# Photo preparation for "film from your photos". Both commands are optional
# ({in} / {out} placeholders); without them the step is reported as skipped.
# Conversion to a clean JPEG is built in (ffmpeg). Examples only:
#   FILM_REMOVE_BG_COMMAND=rembg i {in} {out}
FILM_REMOVE_BG_COMMAND=
FILM_ENHANCE_COMMAND=

# Inpainting / object replacement: a service you operate that implements
# POST {INPAINT_BASE_URL}/inpaint (contract in src/film/inpaint.js).
INPAINT_BASE_URL=
INPAINT_API_KEY=
INPAINT_MODEL=

# Music and voiceover: a folder with audio files, and audio extraction from a
# video page with yt-dlp (must be installed). Hosts are an allowlist.
FILM_MUSIC_DIR=
FILM_ALLOW_AUDIO_DOWNLOAD=true
FILM_AUDIO_HOSTS=youtube.com,youtu.be
YT_DLP_BIN=yt-dlp

# Assembly (ffmpeg and ffprobe must be installed).
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FILM_SUBTITLES=true
FILM_CRF=18
FILM_PRESET=medium
# Finished films are removed after this many days by src/cron/cleanup.js.
FILM_RETENTION_DAYS=30
# Defaults: DATA_DIR/film and DATA_DIR/film-cache.
FILM_WORK_DIR=
FILM_CACHE_DIR=

# --- Desktop app (desktop/, read by Electron only) -------------------------
# Cloud service to open; empty = run the bundled server locally on 127.0.0.1.
REZHISSER_URL=
REZHISSER_START_PATH=/automation
